(--border-soft)}.planTitle{margin:0;color:var(--fg);font-family:var(--font-sans);font-size:clamp(1.25rem,1.8vw,1.6rem);font-weight:700;line-height:1.18}.timeline{margin:.85rem 0 0;color:var(--secondary);font-weight:700}.priceBlock{margin:.85rem 0 0}.startingAt{display:block;margin-bottom:.2rem;color:var(--text-tertiary);font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.priceRange{margin:0;color:var(--fg);font-family:var(--font-heading);font-size:clamp(1.3rem,2vw,1.7rem);font-weight:700}.priceRange span{margin-left:.35rem;color:var(--text-secondary);font-family:var(--font-sans);font-size:.9rem;font-weight:700}.planSubtitle{margin:0;color:var(--text-secondary);font-size:.98rem;line-height:1.7}.bestFor{display:grid;gap:.3rem;padding:.85rem .95rem;border:1px solid var(--border-soft);background:var(--surface-dim)}.bestFor span{color:var(--text-tertiary);font-size:.68rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase}.bestFor strong{color:var(--fg);font-size:.9rem;font-weight:650;line-height:1.45}.featuresList,.teamHighlights{display:grid;gap:.65rem;margin:0;padding:0;list-style:none}.featureItem,.teamHighlights li{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:start;gap:.55rem;color:var(--text-secondary);font-size:.9rem;line-height:1.55}.featureItem i,.teamHighlights i{margin-top:.18rem;color:var(--secondary)}.pricingCard :global(.btn){width:fit-content;margin-top:auto}.teamCard{display:grid;grid-column:1/-1;grid-template-columns:auto minmax(0,1.05fr) minmax(260px,.8fr) auto;align-items:center;gap:clamp(1.2rem,3vw,2rem)}.teamContent{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:1.5rem}.badgeRow{display:flex;align-items:center;flex-wrap:wrap;gap:.75rem}.salePill{display:inline-flex;align-items:center;justify-content:center;padding:.25rem .6rem;border:1px solid rgba(168,111,45,.45);color:var(--accent-orange, #a86f2d);font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.teamPriceBlock{min-width:190px;text-align:right}.priceDisplay{display:flex;align-items:baseline;justify-content:flex-end;gap:.4rem}.priceAmount{color:var(--fg);font-family:var(--font-heading);font-size:clamp(2.1rem,4vw,3.2rem);font-weight:600;line-height:1}.pricePeriod{color:var(--text-secondary);font-size:.95rem;font-weight:600}.priceOriginal{display:block;margin-bottom:.3rem;color:var(--text-tertiary);font-size:.92rem;text-decoration:line-through}.priceNote{margin:.4rem 0 0;color:var(--text-tertiary);font-size:.82rem}.saleCard{border-color:rgba(168,111,45,.45)}.pricingNote{max-width:720px;margin:1rem 0 0;color:var(--text-tertiary);font-size:.9rem;line-height:1.6}.bottomCTA{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;margin-top:1rem;padding-top:2rem;border-top:1px solid var(--border-soft)}.ctaContent h3{margin:0 0 .35rem;color:var(--fg);font-family:var(--font-sans);font-size:1.2rem;font-weight:700}.ctaContent p{max-width:720px;margin:0;color:var(--text-secondary);font-size:.95rem;line-height:1.6}@media (max-width:1100px){.pricingGrid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media (max-width:980px){.teamCard,.teamContent{grid-template-columns:1fr}.teamPriceBlock,.priceDisplay{justify-content:flex-start;text-align:left}.pricingCard :global(.btn){width:100%;justify-content:center}}@media (max-width:680px){.pricingGrid{grid-template-columns:1fr}.sectionHeading{text-align:left}.sectionDescription{margin-left:0}.currencyToolbar{justify-content:flex-start}.bottomCTA{align-items:flex-start;flex-direction:column}}
