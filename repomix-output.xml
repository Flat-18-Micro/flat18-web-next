<file path="src/styles/component-css/WhoThisIsForSection.module.css">
.section {
  position: relative;
  overflow: hidden;
  padding: clamp(4rem, 7vw, 7rem)0;
  background: var(--bg);
  color: var(--fg)
}

.section::before {
  content: "";
  position: absolute;
  inset: 0;
  border-top: 1px solid var(--border-soft);
  border-bottom: 1px solid var(--border-soft);
  pointer-events: none
}

.container {
  width: 100%;
  position: relative;
  z-index: 1
}

.sectionHeader {
  display: grid;
  grid-template-columns: minmax(260px, .42fr) minmax(0, .58fr);
  column-gap: clamp(2rem, 6vw, 6rem);
  row-gap: 1.4rem;
  align-items: end;
  margin-bottom: clamp(2.5rem, 5vw, 4.25rem)
}

.sectionHeader :global(.label-uppercase) {
  grid-column: 1;
  color: var(--text-tertiary)
}

.title {
  grid-column: 1;
  margin: 0;
  color: var(--fg);
  font-family: var(--font-heading);
  font-size: clamp(2.25rem, 4.4vw, 4.55rem);
  font-weight: 400;
  line-height: 1.02;
  letter-spacing: 0;
  text-wrap: balance
}

.intro {
  grid-column: 2;
  margin: 0;
  color: var(--text-secondary);
  font-size: clamp(1.05rem, 1.45vw, 1.22rem);
  line-height: var(--leading-relaxed)
}

.cardGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1px;
  margin: 0;
  padding: 0;
  border: 1px solid var(--border-soft);
  background: var(--border-soft);
  list-style: none
}

.cardItem {
  display: flex;
  min-width: 0
}

.card {
  position: relative;
  isolation: isolate;
  display: flex;
  overflow: hidden;
  width: 100%;
  min-height: 360px;
  flex-direction: column;
  gap: 1.4rem;
  padding: clamp(1.35rem, 2.2vw, 2rem);
  background: var(--bg);
  transition: background .25s ease, box-shadow .25s ease, transform .25s ease
}

.card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  background: linear-gradient(135deg, rgba(24, 58, 143, .075), transparent 42%);
  opacity: 0;
  transition: opacity .25s ease;
  pointer-events: none
}

.card:hover {
  z-index: 1;
  background: linear-gradient(180deg, rgba(255, 255, 255, .035), rgba(255, 255, 255, 0)), var(--bg);
  box-shadow: 0 24px 60px -34px rgba(24, 58, 143, .45);
  transform: translateY(-2px)
}

.card:hover::before {
  opacity: 1
}

.cardTop {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .85rem
}

.cardArt {
  position: relative;
  width: clamp(52px, 4.8vw, 66px);
  aspect-ratio: 1;
  flex: 0 0 auto;
  opacity: .24;
  filter: brightness(0) saturate(100%) invert(19%) sepia(96%) saturate(1614%) hue-rotate(216deg) brightness(83%) contrast(95%) blur(12px);
  transition: opacity .35s ease, filter .35s ease;
  pointer-events: none
}

.cardArt::after {
  content: "";
  position: absolute;
  inset: 7%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(24, 58, 143, .32), rgba(24, 58, 143, 0) 64%);
  opacity: .12;
  mix-blend-mode: multiply;
  transition: opacity .35s ease
}

.cardArt img {
  object-fit: contain
}

.cardIndex {
  display: inline-flex;
  width: fit-content;
  color: var(--secondary);
  font-family: var(--font-heading);
  font-size: clamp(1.45rem, 2.4vw, 2.15rem);
  line-height: 1
}

.cardBody {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 1rem
}

.cardBody h3 {
  margin: 0;
  color: var(--fg);
  font-family: var(--font-sans);
  font-size: clamp(1.18rem, 1.5vw, 1.48rem);
  font-weight: 700;
  line-height: 1.18;
  letter-spacing: 0;
  text-wrap: balance
}

.cardBody p {
  margin: 0;
  color: var(--text-secondary);
  font-size: .96rem;
  line-height: 1.66
}

.actionLine {
  position: relative;
  z-index: 1;
  display: grid;
  gap: .45rem;
  margin: auto 0 0;
  padding-top: 1.1rem;
  /* border-top: 1px solid var(--border-soft); */
  color: var(--fg);
  font-size: .95rem;
  line-height: 1.58
}

.actionLine span {
  color: var(--text-tertiary);
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: .09em;
  line-height: 1.2;
  text-transform: uppercase
}

.ctaPanel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  margin-top: clamp(1.5rem, 3vw, 2.25rem);
  padding-top: clamp(1.4rem, 2.5vw, 2rem);
  /* border-top: 1px solid var(--border-soft) */
}

.ctaPanel p {
  max-width: 760px;
  margin: 0;
  color: var(--text-secondary);
  font-size: clamp(1rem, 1.25vw, 1.1rem);
  line-height: 1.65
}

.ctaActions {
  display: flex;
  flex-shrink: 0;
  flex-wrap: wrap;
  gap: .75rem
}

.ctaActions :global(.btn) {
  white-space: nowrap
}

.section:global(.scrolled) .card {
  opacity: 1;
  transform: none
}

.section:global(.scrolled) .cardItem {
  opacity: 0;
  transform: translateY(18px);
  transition: opacity .62s cubic-bezier(.2, .65, .25, 1), transform .62s cubic-bezier(.2, .65, .25, 1);
  will-change: opacity, transform
}

.section:global(.scrolled-in) .cardItem {
  opacity: 1;
  transform: translateY(0)
}

.section:global(.scrolled-in) .cardItem:nth-child(1) {
  transition-delay: .08s
}

.section:global(.scrolled-in) .cardItem:nth-child(2) {
  transition-delay: .16s
}

.section:global(.scrolled-in) .cardItem:nth-child(3) {
  transition-delay: .24s
}

.section:global(.scrolled-in) .cardItem:nth-child(4) {
  transition-delay: .32s
}

.section:global(.scrolled-in) .cardItem:nth-child(5) {
  transition-delay: .4s
}

.section:global(.scrolled-in) .cardItem:nth-child(6) {
  transition-delay: .48s
}

.section:global(.scrolled-in) .cardArt {
  animation: scenarioArtPulse 18s ease-in-out infinite;
  animation-delay: var(--scenario-delay, .45s)
}

@keyframes scenarioArtPulse {
  0%, 4%, 28%, to {
    opacity: .24;
    filter: brightness(0) saturate(100%) invert(19%) sepia(96%) saturate(1614%) hue-rotate(216deg) brightness(83%) contrast(95%) blur(14px)
  }

  8%, 24% {
    opacity: .72;
    filter: brightness(0) saturate(100%) invert(19%) sepia(96%) saturate(1614%) hue-rotate(216deg) brightness(92%) contrast(96%) blur(0)
  }
}

.cardGrid:hover .cardArt,
.cardGrid:focus-within .cardArt,
.section.hasActiveCard .cardArt {
  animation: none !important;
  animation-play-state: paused !important;
  opacity: .24 !important;
  filter: brightness(0) saturate(100%) invert(19%) sepia(96%) saturate(1614%) hue-rotate(216deg) brightness(83%) contrast(95%) blur(14px) !important;
}

.cardGrid:hover .cardArt::after,
.cardGrid:focus-within .cardArt::after,
.section.hasActiveCard .cardArt::after {
  opacity: .12 !important
}

.card:hover .cardArt,
.card:focus-within .cardArt,
.card.cardInView .cardArt {
  animation: none !important;
  animation-play-state: paused !important;
  opacity: .72 !important;
  filter: brightness(0) saturate(100%) invert(19%) sepia(96%) saturate(1614%) hue-rotate(216deg) brightness(92%) contrast(96%) blur(0) !important;
}

.card:hover .cardArt::after,
.card:focus-within .cardArt::after,
.card.cardInView .cardArt::after {
  opacity: .32 !important
}

@media (max-width:1120px) {
  .cardGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr))
  }

  .card {
    min-height: 330px
  }

  .cardArt {
    width: clamp(52px, 7vw, 62px)
  }
}

@media (max-width:820px) {
  .sectionHeader {
    grid-template-columns: 1fr;
    align-items: start
  }

  .sectionHeader :global(.label-uppercase), .title, .intro {
    grid-column: 1
  }

  .ctaPanel {
    align-items: flex-start;
    flex-direction: column
  }

  .ctaActions {
    width: 100%
  }
}

@media (max-width:640px) {
  .section {
    padding: clamp(3rem, 12vw, 4.5rem)0
  }

  .cardGrid {
    grid-template-columns: 1fr
  }

  .card {
    min-height: auto;
    padding: 1.35rem 0;
    background: var(--bg)
  }

  .card:hover {
    transform: none
  }

  .cardArt {
    width: 52px
  }

  .ctaActions {
    display: grid;
    grid-template-columns: 1fr
  }

  .ctaActions :global(.btn) {
    width: 100%
  }
}

@media (prefers-reduced-motion:reduce) {
  .card, .card::before, .cardArt, .cardArt::after, .cardItem {
    transition: none;
    animation: none
  }

  .card:hover, .section:global(.scrolled) .cardItem {
    transform: none
  }

  .section:global(.scrolled) .cardItem {
    opacity: 1;
    will-change: auto
  }
}
