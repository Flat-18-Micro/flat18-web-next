<file path="src/styles/component-css/FeaturedWork.module.css">
.featuredSection {
  position: relative;
  overflow: hidden;
  padding: 1rem 0 var(--section-spacing-y);
  background-color: var(--bg)
}

.featuredHeading {
  margin-bottom: var(--space-10);
  text-align: center
}

.featuredTitle {
  margin: .75rem 0;
  color: var(--fg);
  font-family: var(--font-heading);
  font-size: var(--text-section-heading);
  font-weight: 600;
  letter-spacing: 0
}

.featuredSubtitle {
  max-width: 760px;
  margin: 0 auto;
  color: var(--text-secondary);
  font-size: clamp(1.06rem, 1.45vw, 1.22rem);
  line-height: var(--leading-relaxed)
}

.featuredGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
  margin-bottom: var(--space-12)
}

.featuredCard {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--border-soft);
  border-radius: 0;
  background: var(--surface-dim);
  transition: box-shadow .3s ease, border-color .3s ease, transform .3s ease
}

.featuredCard:nth-child(n+4) {
  display: none
}

.featuredCard:hover {
  border-color: var(--border-medium);
  box-shadow: 0 24px 60px -30px rgba(35, 64, 255, .3);
  transform: translateY(-4px)
}

.featuredImageWrapper {
  position: relative;
  height: 300px;
  overflow: hidden;
  background: var(--surface-dim)
}

.featuredImage {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top;
  transition: transform .6s ease
}

.featuredCard:hover .featuredImage {
  transform: scale(1.04)
}

.featuredImageWrapper::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 50%, var(--surface-dim) 100%);
  pointer-events: none
}

.featuredLogo {
  position: absolute;
  top: 1rem;
  left: 1.25rem;
  z-index: 2;
  display: flex;
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
  border-radius: 0;
  background: rgba(0, 0, 0, .35);
  box-shadow: 0 4px 12px rgba(0, 0, 0, .25);
  backdrop-filter: blur(10px)
}

.logoImage {
  border-radius: 0
}

.featuredContent {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 1.75rem 2rem 2rem
}

.featuredHeader {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem
}

.featuredProjectTitle {
  margin: 0;
  color: var(--fg);
  font-family: var(--font-sans);
  font-size: 1.4rem;
  font-weight: 700
}

.featuredStatus {
  flex-shrink: 0;
  max-width: 48%;
  padding: .25rem .75rem;
  border: 1px solid rgba(0, 63, 215, .35);
  border-radius: 0;
  background: 0 0;
  color: var(--secondary);
  font-size: .75rem;
  font-weight: 600;
  line-height: 1.35;
  /* text-align: right; */
  /* white-space: nowrap */
}

.featuredDescription {
  margin: 0;
  color: var(--text-secondary);
  font-size: 1rem;
  line-height: 1.65
}

.featuredMetrics {
  display: flex;
  gap: 0;
  overflow: hidden;
  border: 1px solid var(--border-soft);
  border-radius: 0
}

.metric {
  display: flex;
  flex: 1;
  flex-direction: column-reverse;
  gap: .35rem;
  padding: 1rem 1.25rem;
  background: rgba(255, 255, 255, .03)
}

.metric+.metric {
  border-left: 1px solid var(--border-soft)
}

.metricValue {
  color: var(--fg);
  font-family: var(--font-sans);
  font-size: .93rem;
  font-weight: 700;
  line-height: 1.35
}

.metricLabel {
  color: var(--text-tertiary);
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase
}

.capabilityBlock {
  display: grid;
  gap: .55rem;
  padding-top: .25rem
}

.capabilityBlock>span {
  color: var(--text-tertiary);
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase
}

.capabilityBlock ul {
  display: flex;
  flex-wrap: wrap;
  gap: .45rem;
  margin: 0;
  padding: 0;
  list-style: none
}

.capabilityBlock li {
  padding: .34rem .65rem;
  border: 1px solid var(--border-soft);
  background: var(--surface-dim);
  color: var(--text-secondary);
  font-size: .78rem;
  line-height: 1.35
}

.featuredOutcome {
  margin: 0;
  padding-top: 1rem;
  border-top: 1px solid var(--border-soft);
  color: var(--fg);
  font-size: .96rem;
  line-height: 1.62
}

.featuredTech {
  display: flex;
  flex-wrap: wrap;
  gap: .5rem
}

.techBadge {
  padding: .25rem .7rem;
  border: 1px solid var(--border-soft);
  border-radius: 0;
  background: var(--surface-dim);
  color: var(--text-secondary);
  font-size: .75rem
}

.featuredCta {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  margin-top: .25rem;
  color: var(--secondary);
  font-size: .875rem;
  font-weight: 600;
  text-decoration: none;
  transition: color .25s ease, gap .25s ease
}

.featuredCta:hover {
  gap: .75rem;
  color: var(--fg)
}

.featuredFooter {
  text-align: center
}

@media (max-width:900px) {
  .featuredGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem
  }

  .featuredCard:nth-child(n+3) {
    display: none
  }
}

@media (max-width:768px) {
  .featuredSection {
    padding-top: 2.5rem
  }

  .featuredHeading {
    margin-bottom: var(--space-10)
  }

  .featuredTitle {
    font-size: clamp(2rem, 5vw, 2.5rem)
  }

  .featuredImageWrapper {
    height: 240px
  }

  .featuredContent {
    padding: 1.5rem
  }
}

@media (max-width:480px) {
  .featuredGrid {
    gap: 1rem
  }

  .featuredTitle {
    font-size: clamp(1.75rem, 6vw, 2rem)
  }

  .featuredImageWrapper {
    height: 200px
  }

  .featuredContent {
    padding: 1.25rem
  }

  .featuredHeader {
    flex-direction: column
  }

  .featuredStatus {
    max-width: none;
    text-align: left;
    white-space: normal
  }

  .featuredMetrics {
    flex-direction: column
  }

  .metric+.metric {
    border-top: 1px solid var(--border-soft);
    border-left: none
  }
}

@media (max-width:360px) {
  .featuredGrid {
    grid-template-columns: 1fr
  }
}

@media (prefers-reduced-motion:reduce) {
  .featuredCard, .featuredImage {
    transition: none
  }

  .featuredCard:hover {
    transform: none
  }

  .featuredCard:hover .featuredImage {
    transform: none
  }
}
</file>

