<file path="src/styles/globals.css">
@import "./variables.css";
@import "./fonts.css";
@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  --font-display: 'Dela Gothic One', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-heading: 'Dela Gothic One', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-heading-bold: 'Dela Gothic One', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-editorial: 'Colitez Serif', 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
  --font-mono: var(--font-jetbrains-mono), 'JetBrains Mono', 'SF Mono', 'Roboto Mono', Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace
}

@keyframes fadeIn {
  0% {
    opacity: 0
  }

  to {
    opacity: 1
  }
}

@keyframes slideUp {
  0% {
    transform: translateY(20px);
    opacity: 0
  }

  to {
    transform: translateY(0);
    opacity: 1
  }
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(25, 253, 178, .4)
  }

  70% {
    box-shadow: 0 0 0 10px transparent
  }

  to {
    box-shadow: 0 0 0 0 transparent
  }
}

*, ::after, ::before {
  box-sizing: border-box;
  margin: 0;
  padding: 0
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
  height: 100%;
  overflow-x: hidden
}

body {
  font-family: var(--font-sans);
  background-color: var(--bg);
  color: var(--text-primary);
  line-height: var(--leading-normal);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
  min-height: 100%;
  position: relative;
  padding-top: 88px;
  width: 100%;
  max-width: 100vw
}

@media (prefers-reduced-motion:reduce) {
  body {
    transition: none
  }
}

::-webkit-scrollbar {
  width: 10px;
  height: 10px
}

::-webkit-scrollbar-track {
  background: var(--bg-dark-accent)
}

::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, .1);
  border-radius: 10px
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, .2)
}

::selection {
  background-color: rgba(35, 64, 255, .25)
}

h1, h2 {
  margin: 0;
  line-height: 1.08;
  font-weight: var(--font-normal);
  font-family: var(--font-heading);
  letter-spacing: 0;
  text-balance: balance
}

h1 {
  font-size: var(--text-display);
  letter-spacing: 0;
  font-weight: var(--font-normal);
  font-family: var(--font-heading);
  max-width: 12ch
}

h1 strong, h1 .heavy, .hero-heavy {
  font-family: var(--font-heading-bold);
  font-weight: var(--font-normal);
  letter-spacing: 0
}

.editorial-accent {
  font-family: var(--font-heading);
  font-style: normal;
  font-weight: 400;
  letter-spacing: 0
}

h2 {
  font-size: var(--text-section-heading);
  letter-spacing: 0;
  font-weight: var(--font-normal);
  font-family: var(--font-heading)
}

h3 {
  font-size: var(--text-3xl);
  font-weight: var(--font-bold);
  font-family: var(--font-sans);
  letter-spacing: 0;
  line-height: var(--leading-snug)
}

h4 {
  font-size: var(--text-2xl);
  font-weight: var(--font-bold);
  font-family: var(--font-sans);
  letter-spacing: 0;
  line-height: var(--leading-snug)
}

h5 {
  font-size: var(--text-xl);
  font-weight: var(--font-bold);
  font-family: var(--font-sans);
  letter-spacing: 0;
  line-height: var(--leading-snug)
}

h6 {
  font-size: var(--text-lg);
  font-weight: var(--font-bold);
  font-family: var(--font-sans);
  letter-spacing: 0;
  line-height: var(--leading-snug)
}

p {
  margin-bottom: var(--space-4);
  color: var(--text-secondary);
  font-size: 1.125rem;
  line-height: 1.7
}

a {
  color: var(--accent-teal);
  text-decoration: none;
  transition: color var(--transition-fast), text-shadow var(--transition-fast)
