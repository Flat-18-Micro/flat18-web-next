        min-height: 630px;
        border: 1px solid var(--line);
        background: #f8fafc;
        border-radius: 18px;
        padding: 12px;
        display: grid;
        align-content: start;
        gap: 10px;
      }

      .day-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 800;
        color: #334155;
      }

      .event {
        padding: 12px;
        border-radius: 14px;
        background: white;
        border: 1px solid var(--line);
        display: grid;
        gap: 8px;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.05);
      }

      .event.highlight {
        border-color: rgba(37, 99, 235, 0.35);
        box-shadow: 0 12px 24px rgba(37, 99, 235, 0.12);
      }

      .platforms {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
      }

      .platform {
        width: 26px;
        height: 26px;
        border-radius: 9px;
        display: grid;
        place-items: center;
        background: #e0f2fe;
        color: #0369a1;
        font-size: 11px;
        font-weight: 850;
      }

      .platform.x {
        background: #e2e8f0;
        color: #0f172a;
      }

      .platform.li {
        background: #dbeafe;
        color: #1d4ed8;
      }

      .platform.rd {
        background: #ffedd5;
        color: #c2410c;
      }

      .compose {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr 0.82fr;
        gap: 18px;
      }

      textarea,
      input {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 14px;
        font: inherit;
        background: #fbfdff;
      }

      textarea {
        min-height: 230px;
        resize: none;
        line-height: 1.55;
      }

      .media-strip {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
      }

      .media {
        aspect-ratio: 1.3;
        border-radius: 16px;
        background:
          linear-gradient(135deg, rgba(37, 99, 235, 0.85), rgba(22, 163, 74, 0.7)),
          linear-gradient(45deg, #dbeafe, #dcfce7);
        display: grid;
        place-items: center;
        color: white;
        font-weight: 850;
      }

      .preview {
        border: 1px solid var(--line);
        border-radius: 20px;
        padding: 18px;
        background: white;
        display: grid;
        gap: 12px;
      }

      .preview:nth-child(2) {
        background: #fbfdff;
      }

      .preview-author {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .checks {
        display: grid;
        gap: 10px;
      }

      .check {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 12px;
      }

      .progress {
        height: 9px;
        border-radius: 999px;
        background: #e2e8f0;
        overflow: hidden;
      }

      .progress span {
        display: block;
        height: 100%;
        background: var(--green);
        border-radius: inherit;
      }

      .status-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
      }

      .timeline {
        display: grid;
        gap: 12px;
      }

      .log {
        border-left: 4px solid var(--green);
        padding: 12px 14px;
        background: #fbfdff;
        border-radius: 0 14px 14px 0;
      }

      .log.warn {
        border-color: var(--orange);
      }

      .log.bad {
        border-color: var(--red);
      }

      .screen {
        display: none;
      }

      .screen.active {
        display: contents;
      }
